datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  summary      String?
  description  String
  technologies String[] // Array of technologies used
  imageUrls    String[] // Image references
  githubUrl    String?  // GitHub source URL
  liveDemoUrl  String?  // Live-demo URL
  published    Boolean  @default(true) // Publication status
  category     String   @default("Web Development")
  featured     Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([published])
  @@map("projects")
}

model ContactMessage {
  id         String   @id @default(uuid())
  senderName String   // Sender name
  email      String   // Sender email
  subject    String?  // Subject
  message    String   // Message body
  status     String   @default("unread") // Message status: "unread" | "read" | "archived"
  createdAt  DateTime @default(now())   // Timestamp

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

model SiteMetric {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  label     String

  @@map("site_metrics")
}
